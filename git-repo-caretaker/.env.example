# ─────────────────────────────────────────────────────────────────────────────
# Git-Repo-Caretaker  –  Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# GitHub Personal Access Token
# Scopes needed: repo, workflow, read:org
# Create at: https://github.com/settings/tokens
GH_TOKEN=
# OpenRouter API Key
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────────

# Override repo (also settable in config.yaml)
# GITHUB_REPO=username/my-repo

# Override LLM model
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default branch
# DEFAULT_BRANCH=main

# Path to config file
# CONFIG_PATH=config.yaml

# GitHub Webhook secret (set the same value in GitHub repo Settings → Webhooks)
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Max dependency PRs to open per run
# MAX_DEPENDENCY_PRS=5

# README similarity threshold (0.0 – 1.0)
# README_SIMILARITY_THRESHOLD=0.85

# ── Email / SMTP (for daily digest emails) ───────────────────────────────────

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password   # use Gmail App Password, not your real password
# DIGEST_EMAIL=you@gmail.com
